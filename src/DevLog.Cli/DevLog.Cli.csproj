<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevLog</RootNamespace>
    <AssemblyName>devlog</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>devlog</ToolCommandName>
    <PackageId>DevLog.Cli</PackageId>
    <Version>1.5.31</Version>
    <Authors>Sezer TANCI</Authors>
    <Description>Lokal yapilacak is (todo) ve calisma gunlugu (worklog) kaydi</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ui.html" />
    <EmbeddedResource Include="Assets\*.md" />
  </ItemGroup>

</Project>







































